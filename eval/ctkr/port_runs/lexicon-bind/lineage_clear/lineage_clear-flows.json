{
  "version": 1,
  "flows": [
    {
      "key": "b0s-clear-a-mother-keeps-the-child-parentage",
      "title": "Retracting a birth record's mother removes her from the record and leaves the child's parentage standing",
      "feature": "lineage",
      "glossary_terms": ["animal", "record_birth", "correct_birth", "birth_mother", "parent_count", "has_parent", "birth_record_count"],
      "given": [
        {"entity": "animal", "alias": "DAM", "name": "b0s-Clear Dam Willow", "descriptor": "Cattle", "sex": "F"},
        {"entity": "animal", "alias": "KID", "name": "b0s-Clear Kid Bracken", "descriptor": "Cattle"}
      ],
      "when": [
        {"action": "record_birth", "alias": "B", "ref": "KID", "parents": ["DAM"], "name": "b0s-Birth to be retracted", "status": "done", "at": "2026-03-01T12:00:00+00:00"},
        {"action": "correct_birth", "ref": "B", "clear_parents": true}
      ],
      "probes": [
        {"assert": "birth_mother", "subject": "B", "other": "DAM"},
        {"assert": "parent_count", "subject": "KID"},
        {"assert": "has_parent", "subject": "KID", "other": "DAM"},
        {"assert": "birth_record_count", "subject": "KID"}
      ]
    },
    {
      "key": "b0s-clear-a-mother-contrast-not-cleared",
      "title": "The same birth left alone: the mother stands on the record — the discriminating contrast to the retraction",
      "feature": "lineage",
      "glossary_terms": ["animal", "record_birth", "birth_mother", "parent_count", "has_parent", "birth_record_count"],
      "given": [
        {"entity": "animal", "alias": "DAM", "name": "b0s-Kept Dam Rowan", "descriptor": "Cattle", "sex": "F"},
        {"entity": "animal", "alias": "KID", "name": "b0s-Kept Kid Alder", "descriptor": "Cattle"}
      ],
      "when": [
        {"action": "record_birth", "alias": "B", "ref": "KID", "parents": ["DAM"], "name": "b0s-Birth left standing", "status": "done", "at": "2026-03-01T12:00:00+00:00"}
      ],
      "probes": [
        {"assert": "birth_mother", "subject": "B", "other": "DAM"},
        {"assert": "parent_count", "subject": "KID"},
        {"assert": "has_parent", "subject": "KID", "other": "DAM"},
        {"assert": "birth_record_count", "subject": "KID"}
      ]
    },
    {
      "key": "b0s-clear-the-childs-own-parentage",
      "title": "Clearing an animal's stated parentage empties it, where clearing its birth record's mother did not",
      "feature": "lineage",
      "glossary_terms": ["animal", "set_parents", "parent_count", "has_parent"],
      "given": [
        {"entity": "animal", "alias": "DAM", "name": "b0s-Detach Dam Hazel", "descriptor": "Cattle", "sex": "F"},
        {"entity": "animal", "alias": "KID", "name": "b0s-Detach Kid Sorrel", "descriptor": "Cattle"}
      ],
      "when": [
        {"action": "set_parents", "ref": "KID", "parents": ["DAM"]},
        {"action": "set_parents", "ref": "KID", "clear_parents": true}
      ],
      "probes": [
        {"assert": "parent_count", "subject": "KID"},
        {"assert": "has_parent", "subject": "KID", "other": "DAM"}
      ]
    },
    {
      "key": "b0s-second-parent-on-the-animal",
      "title": "An animal carries two stated parents where its birth record carries one",
      "feature": "lineage",
      "glossary_terms": ["animal", "record_birth", "set_parents", "parent_count", "has_parent", "birth_mother"],
      "given": [
        {"entity": "animal", "alias": "DAM", "name": "b0s-Two Dam Meadow", "descriptor": "Cattle", "sex": "F"},
        {"entity": "animal", "alias": "SIRE", "name": "b0s-Two Sire Thorn", "descriptor": "Cattle", "sex": "M"},
        {"entity": "animal", "alias": "KID", "name": "b0s-Two Kid Vetch", "descriptor": "Cattle"}
      ],
      "when": [
        {"action": "record_birth", "alias": "B", "ref": "KID", "parents": ["DAM"], "name": "b0s-Birth from the dam", "status": "done", "at": "2026-03-01T12:00:00+00:00"},
        {"action": "set_parents", "ref": "KID", "parents": ["DAM", "SIRE"]}
      ],
      "probes": [
        {"assert": "parent_count", "subject": "KID"},
        {"assert": "has_parent", "subject": "KID", "other": "DAM"},
        {"assert": "has_parent", "subject": "KID", "other": "SIRE"},
        {"assert": "birth_mother", "subject": "B", "other": "DAM"},
        {"assert": "birth_mother", "subject": "B", "other": "SIRE"}
      ]
    },
    {
      "key": "b0s-second-parent-on-a-birth-record-is-refused",
      "title": "A birth record naming two parents is refused: the source states its own single-mother limit",
      "feature": "lineage",
      "glossary_terms": ["animal", "record_birth", "refused"],
      "given": [
        {"entity": "animal", "alias": "DAM", "name": "b0s-Refused Dam Bryony", "descriptor": "Cattle", "sex": "F"},
        {"entity": "animal", "alias": "SIRE", "name": "b0s-Refused Sire Ash", "descriptor": "Cattle", "sex": "M"},
        {"entity": "animal", "alias": "KID", "name": "b0s-Refused Kid Teasel", "descriptor": "Cattle"}
      ],
      "when": [
        {"action": "record_birth", "alias": "B", "ref": "KID", "parents": ["DAM", "SIRE"], "name": "b0s-Birth naming two parents", "status": "done", "at": "2026-03-01T12:00:00+00:00"}
      ],
      "expect_refusal": true,
      "probes": []
    },
    {
      "key": "b0s-a-birth-mother-does-not-displace-a-stated-parent",
      "title": "Recording a birth from a dam adds nothing when the child already has a stated parent",
      "feature": "lineage",
      "glossary_terms": ["animal", "record_birth", "set_parents", "parent_count", "has_parent", "birth_mother"],
      "given": [
        {"entity": "animal", "alias": "DAM", "name": "b0s-Late Dam Comfrey", "descriptor": "Cattle", "sex": "F"},
        {"entity": "animal", "alias": "SIRE", "name": "b0s-Late Sire Bramble", "descriptor": "Cattle", "sex": "M"},
        {"entity": "animal", "alias": "KID", "name": "b0s-Late Kid Nettle", "descriptor": "Cattle"}
      ],
      "when": [
        {"action": "set_parents", "ref": "KID", "parents": ["SIRE"]},
        {"action": "record_birth", "alias": "B", "ref": "KID", "parents": ["DAM"], "name": "b0s-Birth after a stated parent", "status": "done", "at": "2026-03-01T12:00:00+00:00"}
      ],
      "probes": [
        {"assert": "parent_count", "subject": "KID"},
        {"assert": "has_parent", "subject": "KID", "other": "SIRE"},
        {"assert": "has_parent", "subject": "KID", "other": "DAM"},
        {"assert": "birth_mother", "subject": "B", "other": "DAM"}
      ]
    }
  ]
}
