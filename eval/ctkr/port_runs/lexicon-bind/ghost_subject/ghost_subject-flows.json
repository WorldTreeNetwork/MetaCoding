{
  "version": 1,
  "flows": [
    {
      "key": "b0s-ghost-asset-has-no-active-state",
      "title": "An asset that was never created has no active state to read: the question is unanswerable, not true and not false",
      "feature": "asset-lifecycle",
      "glossary_terms": ["land", "asset_active"],
      "given": [
        {"entity": "land", "alias": "GHOST", "name": "b0s-Field That Was Never Made", "ghost": true}
      ],
      "when": [],
      "probes": [
        {"assert": "asset_active", "subject": "GHOST", "unanswerable": true}
      ]
    },
    {
      "key": "b0s-ghost-contrast-a-real-asset-is-active",
      "title": "The same question of an asset that exists: the discriminating contrast to the ghost",
      "feature": "asset-lifecycle",
      "glossary_terms": ["land", "asset_active", "archive_asset"],
      "given": [
        {"entity": "land", "alias": "LIVE", "name": "b0s-Field That Exists"},
        {"entity": "land", "alias": "GONE", "name": "b0s-Field That Was Retired"}
      ],
      "when": [
        {"action": "archive_asset", "ref": "GONE"}
      ],
      "probes": [
        {"assert": "asset_active", "subject": "LIVE"},
        {"assert": "asset_active", "subject": "GONE"}
      ]
    },
    {
      "key": "b0s-ghost-and-real-side-by-side",
      "title": "Active, archived and never-created are three answers, not two: the third is no answer at all",
      "feature": "asset-lifecycle",
      "glossary_terms": ["land", "asset_active", "archive_asset"],
      "given": [
        {"entity": "land", "alias": "LIVE", "name": "b0s-Trio Field Standing"},
        {"entity": "land", "alias": "GONE", "name": "b0s-Trio Field Retired"},
        {"entity": "land", "alias": "GHOST", "name": "b0s-Trio Field Never Made", "ghost": true}
      ],
      "when": [
        {"action": "archive_asset", "ref": "GONE"}
      ],
      "probes": [
        {"assert": "asset_active", "subject": "LIVE"},
        {"assert": "asset_active", "subject": "GONE"},
        {"assert": "asset_active", "subject": "GHOST", "unanswerable": true}
      ]
    },
    {
      "key": "b0s-ghost-animal-has-no-sex-to-read",
      "title": "A never-created animal has no sex to read, where a created one with none delivers the empty value",
      "feature": "lineage",
      "glossary_terms": ["animal", "animal_sex", "parent_count"],
      "given": [
        {"entity": "animal", "alias": "REAL", "name": "b0s-Ghost Contrast Heifer", "descriptor": "Cattle"},
        {"entity": "animal", "alias": "GHOST", "name": "b0s-Animal That Was Never Born", "ghost": true}
      ],
      "when": [],
      "probes": [
        {"assert": "animal_sex", "subject": "REAL"},
        {"assert": "parent_count", "subject": "REAL"},
        {"assert": "animal_sex", "subject": "GHOST", "unanswerable": true},
        {"assert": "parent_count", "subject": "GHOST", "unanswerable": true}
      ]
    }
  ]
}
