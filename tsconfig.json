{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // The shared kernel is a real package (@metacoding/kernel, src/kernel/
    // package.json) so port builds consume it by NAME instead of climbing
    // ../../../../../../ out of whatever tree contains them (MetaCoding-1gt.3).
    // Runtime resolution comes from the bun workspace member in package.json,
    // which SYMLINKS src/kernel into node_modules — no copy here to drift, and
    // unlike a "paths" entry it is not shadowed by the builds' nested tsconfigs.
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The viz/ app targets the browser (DOM/WebWorker libs) and has its own
  // tsconfig; keep it out of the library-side compile.
  "exclude": ["node_modules", "viz"]
}
